{
  "schema_version": "2.0.0",
  "validator_version": "2.0.0",
  "scope": "mechanical_prompt_lint_result",
  "governance_completeness": "not_assessed",
  "input_contract": {
    "encoding": "strict_utf8",
    "maximum_bytes": 2097152,
    "field_name_pattern": "^[a-z][a-z0-9_]*$",
    "unknown_field_policy": "accept"
  },
  "capabilities": [
    "bounded_prompt_parsing",
    "duplicate_field_detection",
    "placeholder_detection",
    "mapping_and_fence_structure_checks",
    "supplied_value_normalization",
    "internal_consistency",
    "mechanical_validity"
  ],
  "diagnostic_ids": {
    "INPUT001": "unreadable_or_unsupported_input",
    "PARSE001": "unclosed_fence",
    "PARSE002": "duplicate_field",
    "PLACEHOLDER001": "unresolved_token",
    "CONSISTENCY001": "commit_state_contradiction",
    "CONSISTENCY002": "execution_state_contradiction",
    "CONSISTENCY003": "materialization_state_contradiction"
  },
  "exit_codes": {
    "mechanically_valid_and_internally_consistent": 0,
    "cli_input_or_local_schema_error": 2,
    "prompt_mechanical_or_consistency_error": 3,
    "output_collision_or_write_error": 4
  }
}
