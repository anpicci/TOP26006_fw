{
  "schema_version": "1.0.2",
  "renderer_version": "1.0.2",
  "ownership_contract_version": "1.0.2",
  "primary_authoring_format": "markdown",
  "transport_identity": "unavailable_not_required_not_claimed",
  "evidence_sequence": [
    "collect_direct_evidence",
    "serialize_evidence",
    "reopen_and_validate_evidence",
    "classify_evidence",
    "derive_verdict"
  ],
  "evidence_sequence_compact": "collect_direct_evidence -> serialize_evidence -> reopen_and_validate_evidence -> classify_evidence -> derive_verdict",
  "generated_artifacts": {
    "authored_prompt.md": {
      "type": "utf8_markdown",
      "required": true,
      "cross_hash": "preflight_state.source_sha256"
    },
    "canonical_prompt.md": {
      "type": "utf8_markdown",
      "required_when": "canonicalized",
      "cross_hash": "preflight_state.canonical_prompt_sha256"
    },
    "section_manifest.json": {
      "type": "closed_object",
      "required_keys": [
        "prompt_id",
        "source_line_count",
        "source_section_count",
        "canonical_section_count",
        "records"
      ],
      "required_item_keys": [
        "source_heading",
        "canonical_heading",
        "ownership",
        "source_start_line",
        "source_end_line",
        "source_sha256",
        "canonical_sha256",
        "preserved_exactly",
        "alias_applied",
        "authoritative_in_canonical"
      ]
    },
    "shared_value_manifest.json": {
      "type": "closed_object",
      "required_keys": [
        "prompt_id",
        "records",
        "author_semantic_invention_count",
        "author_semantic_change_count"
      ]
    },
    "prompt_contract_validation.json": {
      "type": "closed_installed_validator_object",
      "required_keys_when_invoked": [
        "error_count",
        "warning_count",
        "canonical_prompt_sha256",
        "validator_input_sha256_matches_canonical"
      ]
    },
    "preflight_state.json": {
      "type": "closed_object",
      "required_keys": [
        "current_state",
        "states_visited",
        "source_sha256",
        "agents_sha256",
        "cpc_sha256",
        "blocking_error_count",
        "diagnostics"
      ]
    },
    "preflight_report.md": {
      "type": "utf8_markdown",
      "required_headings": [
        "# Prompt preflight report",
        "## Preflight result",
        "## Diagnostics",
        "## Governance hashes"
      ]
    },
    "readiness_binding.json": {
      "type": "closed_object",
      "required_keys": [
        "prompt_id",
        "authored_prompt_sha256",
        "canonical_prompt_sha256",
        "prompt_contract_input_sha256",
        "prompt_contract_validation_sha256",
        "section_manifest_sha256",
        "shared_value_manifest_sha256",
        "preflight_report_sha256",
        "preflight_state_sha256_without_self_field",
        "AGENTS_sha256",
        "CPC_sha256",
        "workspace_root",
        "diagnostics_root",
        "output_root_identity",
        "state_sequence",
        "current_state",
        "blocking_error_count",
        "warning_count",
        "created_by_skill_version",
        "created_by_renderer_version",
        "ownership_contract_version",
        "schema_version",
        "required_artifacts"
      ]
    }
  },
  "shared_structured_grammar": {
    "mapping_fences": 1,
    "language": "text",
    "outside_mapping": ["blank_lines", "restricted_inert_html_comments"]
  },
  "descriptor_rooted_io": true,
  "readiness_requires_complete_bound_package": true,
  "fixed_subprocesses": [
    "git branch --show-current",
    "git rev-parse HEAD",
    "git show -s --format=%s HEAD",
    "correction-lib-prompt-contract/scripts/validate_prompt.py"
  ],
  "forbidden_interfaces": [
    "task_callback",
    "shell_true",
    "prompt_content_as_argv",
    "prompt_authored_import",
    "codex_command",
    "nested_session",
    "patch_application",
    "publication"
  ]
}
