  "evidence_return_contract": [
    "Return each persistent command log and the explicit qualification artifacts requested by the validated plan."
  ],
  "provenance": {
    "record": {
      "branch": null,
      "commit": null,
      "configuration_hashes": {}
    },
    "enforce": {
      "branch": false,
      "commit": false
    }
  }
